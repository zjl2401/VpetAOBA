<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/roomRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:background="@color/room_wall">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="48dp"
        android:text="@string/room_title"
        android:textColor="@color/accent_pink"
        android:textSize="20sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/sizeBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="48dp"
        android:layout_marginEnd="16dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnSizeS"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="小"
            android:textSize="12sp"
            android:minHeight="0dp"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnSizeM"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="中"
            android:textSize="12sp"
            android:minHeight="0dp"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnSizeL"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="大"
            android:textSize="12sp"
            android:minHeight="0dp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/petImage"
        android:layout_width="128dp"
        android:layout_height="128dp"
        android:layout_gravity="center"
        android:scaleType="fitCenter"
        android:contentDescription="@string/app_name" />

    <LinearLayout
        android:id="@+id/menuHost"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:orientation="vertical" />
</FrameLayout>
