<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_blue_gradient">

    <com.vpet.mobile.DataStreamView
        android:id="@+id/dataStream"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/btnClosePage"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:gravity="center"
        android:text="×"
        android:textColor="@color/theme_blue_deep"
        android:textSize="28sp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="关闭"
        android:elevation="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:gravity="center_horizontal"
        android:elevation="4dp">

        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/app_cover"
            android:contentDescription="@string/app_name"
            android:layout_marginBottom="16dp"
            android:scaleType="fitCenter" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/accent_pink"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"
            android:shadowColor="@color/theme_blue_deep"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="4" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="命运比特流涌动中…"
            android:textColor="@color/theme_blue_deep"
            android:textSize="12sp"
            android:alpha="0.75"
            android:layout_marginBottom="20dp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_main"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="20dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnStartOverlay"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="开启桌宠"
            android:textSize="16sp"
            android:background="@drawable/bg_btn_light"
            android:backgroundTint="@null"
            android:textColor="@color/text_main" />
    </LinearLayout>
</FrameLayout>
