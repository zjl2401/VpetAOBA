<?xml version="1.0" encoding="utf-8"?>
<!-- 可爱像素面板：粉外框 + 奶油底 + 贴纸顶条 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/menuChrome"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFF7EB0"
    android:padding="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#FFFFA8CC"
        android:gravity="center_vertical"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp">

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="#FFFFFFFF" />

        <View
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:background="#FFFFF8FB" />

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="#FF7EC8FF" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/menuRoot"
        android:layout_width="236dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFF8FB"
        android:padding="6dp">

        <LinearLayout
            android:id="@+id/moduleRow"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical" />

        <com.vpet.mobile.PixelDividerView
            android:id="@+id/menuDivider"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:id="@+id/subList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <TextView
            android:id="@+id/btnMenuClose"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="×"
            android:textColor="#FF4A3550"
            android:textSize="16sp"
            android:background="#FFFFD6E8" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="#FF7EC8FF" />
</LinearLayout>
